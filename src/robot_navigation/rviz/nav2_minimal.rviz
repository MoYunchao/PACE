Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /Map1
        - /Path1
        - /LaserScan1
        - /LaserScan1/Topic1
        - /Marker1
        - /Marker1/Topic1
      Splitter Ratio: 0.5
    Tree Height: 230
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: LaserScan
  - Class: rviz_common/Transformation
    Name: Transformation
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 371
  - Class: rviz_common/Tool Properties
    Expanded:
      - /Interact1
      - /2D Pose Estimate1
    Name: Tool Properties
    Splitter Ratio: 0.5
  - Class: rviz_common/Selection
    Name: Selection
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
