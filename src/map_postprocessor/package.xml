<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>map_postprocessor</name>
  <version>1.0.0</version>
  <description>
    Map postprocessor for removing isolated unreachable free cells from SLAM maps.
    Uses connected component analysis (flood-fill) from robot position to identify
    and clean noise caused by laser beams penetrating thin obstacles.
  </description>
  <maintainer email="sunny@sensebeetle.com">SenseBeetle</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
